{
  "name": "notary-aml",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4001",
    "dev:lan": "next dev -H 0.0.0.0 -p 4001",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4001",
    "start:lan": "next start -H 0.0.0.0 -p 4001",
    "lint": "eslint",
    "sync:sheets": "tsx -r dotenv/config scripts/sync-google-sheets.ts dotenv_config_path=.env",
    "up": "next build && pm2 startOrReload ecosystem.config.js",
    "down": "pm2 stop notary-aml",
    "restart": "pm2 restart notary-aml",
    "status": "pm2 status",
    "logs": "pm2 logs notary-aml"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.2",
    "framer-motion": "^13.0.0",
    "google-auth-library": "^11.0.0",
    "lucide-react": "^1.29.0",
    "next": "16.2.12",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pm2": "^5.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
