# Salin file ini menjadi .env dan isi nilainya. .env tidak di-commit ke git
# (lihat .gitignore) karena berisi rahasia (PIN, kredensial Google).

DATABASE_URL="file:./prisma/dev.db"

# --- URL Kanonik Aplikasi (wajib diisi untuk deployment intranet HTTPS) -------
# Kosongkan (atau hapus baris ini) untuk akses lokal langsung http://127.0.0.1.
# Isi dengan URL publik intranet kalau app diakses lewat reverse proxy HTTPS,
# mis. Caddy di depan Next.js. Nilai ini menentukan dua hal:
#   1. Secure flag pada cookie sesi (true kalau dimulai "https://")
#   2. Redirect URI yang dikirim ke Google OAuth ("Lupa PIN") supaya cocok
#      dengan yang terdaftar di Google Cloud Console
# Jangan akhiri dengan garis miring (/). Tidak pernah diekspos ke browser
# (bukan NEXT_PUBLIC_*) — hanya dibaca oleh server.
# APP_BASE_URL="https://amlguard.notaris.co.id"

# Port standar aplikasi ini — dipakai konsisten di `npm run dev`/`start`
# (lihat package.json, hardcoded `-p 4001`) dan `npm run up` (PM2, lihat
# ecosystem.config.js). Kalau diubah, redirect URI OAuth "Lupa PIN" di Google
# Cloud Console juga harus diperbarui ke port yang sama (lihat SETUP.md).
PORT="4001"

# --- FR-6B: PIN Gate (wajib diisi agar aplikasi bisa diakses) ---------
# PIN_HASH = hash scrypt dari PIN akses kantor (4-6 digit), BUKAN plaintext.
# Hasilkan dengan: npx tsx scripts/hash-pin.ts <PIN-PILIHAN-ANDA>
# Format baru: $scrypt$N=32768,r=8,p=1$<salt>$<hash> (memory-hard, salted).
# Format lama (SHA-256 hex) masih diterima dan otomatis di-upgrade ke scrypt
# saat login berhasil berikutnya — tidak perlu generate ulang secara manual.
# Lihat SETUP.md untuk cara reset PIN kalau lupa.
PIN_HASH=""

# SESSION_SECRET = string acak panjang untuk menandatangani cookie sesi.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mengubah nilai ini akan membuat semua sesi yang sedang aktif logout.
# HANYA dipakai untuk sesi login — TIDAK LAGI jadi sumber kunci enkripsi
# data/dokumen sejak security hardening pass (key separation, lihat dua
# variabel di bawah). Data lama yang masih format v1 (dienkripsi sebelum
# key separation) tetap dibaca lewat SESSION_SECRET secara otomatis — jangan
# hapus/ganti nilai ini sampai `npm run security:migrate-encryption` selesai
# dijalankan dan berhasil, walau kunci baru di bawah sudah diisi.
SESSION_SECRET=""

# --- Kunci Enkripsi Terpisah (opsional, tapi SANGAT DIREKOMENDASIKAN) ------
# Sebelum key separation, SESSION_SECRET dipakai untuk sesi login DAN
# enkripsi dokumen/data OCR sekaligus — kalau bocor, keduanya kompromi
# bersamaan. Dua variabel di bawah memisahkannya: mengubah SESSION_SECRET
# (mis. rotasi rutin) TIDAK LAGI merusak data yang sudah dimigrasikan.
#
# Kosongkan KEDUANYA untuk tetap memakai skema lama (v1, SESSION_SECRET) —
# aplikasi tetap berjalan normal, tidak wajib diisi segera. Isi KEDUANYA
# (tidak boleh cuma salah satu — aplikasi akan menolak start kalau cuma
# satu yang diisi) untuk pindah ke skema baru (v2) untuk SEMUA tulisan baru.
# Data lama (v1) tetap otomatis terbaca lewat SESSION_SECRET sampai Anda
# menjalankan: npm run security:migrate-encryption
#
# PENTING: setelah migrasi berhasil dijalankan minimal sekali (ditandai
# storage/encryption-migration-status.json), aplikasi TIDAK BOLEH start
# lagi tanpa dua kunci ini terisi — fail closed, bukan silang generate
# kunci baru. Backup nilai ini di tempat AMAN TERPISAH dari server (mis.
# password manager kantor) — kunci yang hilang berarti data terenkripsi
# yang sudah dimigrasikan TIDAK BISA dipulihkan oleh siapa pun, termasuk
# developer aplikasi ini.
#
# Hasilkan masing-masing dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY untuk field OCR/terstruktur di database (ocrRawText,
# fieldGuesses). DOCUMENT_ENCRYPTION_KEY untuk file scan di storage/uploads/.
# Harus BEDA satu sama lain dan beda dari SESSION_SECRET.
DATA_ENCRYPTION_KEY=""
DOCUMENT_ENCRYPTION_KEY=""

# --- FR-1.2: Sinkronisasi HDD Eksternal (opsional) --------------------
# BACKUP_HDD_PATH = folder tujuan di HDD eksternal (mis. drive letter di
# Windows). Dicek tiap kali aplikasi start (bukan terjadwal presisi) — kalau
# drive tidak terpasang saat itu, dilewati diam-diam dan dicoba lagi di
# start berikutnya. Kosongkan untuk menonaktifkan.
# BACKUP_HDD_PATH="E:\notaris-backup"

# --- Integrasi Google Sheets (opsional, FR-1.3) — kosongkan untuk
# menonaktifkan fitur "Export ke Google Sheet" / sinkron otomatis saat CDD
# jadi Lengkap. Lihat panduan setup di percakapan/README.
# GOOGLE_SHEETS_SPREADSHEET_ID="..."
# GOOGLE_SERVICE_ACCOUNT_EMAIL="...@....iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SHEET_NAME="Sheet1"

# --- FR-1.4: Google Drive (opsional) — backup scan/foto ID. Pakai Service
# Account yang sama dengan Google Sheets di atas (GOOGLE_SERVICE_ACCOUNT_*),
# scope Drive-nya dibatasi ke file yang dibuat sendiri (drive.file). Buat
# folder khusus (bukan personal) di Drive akun tersebut, share ke email
# Service Account, salin ID foldernya dari URL Drive ke bawah ini.
# GOOGLE_DRIVE_FOLDER_ID="..."

# --- Lupa PIN lewat Google Sign-In (opsional) — kosongkan salah satu untuk
# menonaktifkan tombol "Masuk dengan Google" di halaman /lock/forgot (PIN
# tetap bisa direset manual lewat PIN_HASH di atas + restart). BEDA dari
# Service Account di atas: ini OAuth Client ID tipe "Web application" untuk
# Sign-In pengguna asli, bukan autentikasi mesin-ke-mesin. Lihat SETUP.md
# untuk cara membuatnya di Google Cloud Console.
# GOOGLE_OAUTH_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="..."
# PIN_RECOVERY_GOOGLE_EMAIL = HANYA akun Google dengan email ini yang boleh
# berhasil reset PIN lewat "Lupa PIN" — dicocokkan persis (case-insensitive)
# terhadap email akun yang login, siapa pun boleh mencoba login tapi cuma
# pemilik email ini yang lolos.
# PIN_RECOVERY_GOOGLE_EMAIL="notaris@gmail.com"

# --- AI Processing Engine (opsional) — provider-agnostic AI (lib/ai/).
# TIDAK dipakai oleh alur OCR formulir cetak yang sudah ada (tetap Tesseract
# lokal, lihat lib/ocr/) — ini kapabilitas terpisah, baru aktif kalau
# fitur yang memakainya dibangun di kemudian hari. Semua nilai di bawah cuma
# jadi default awal; bisa diubah kapan saja lewat halaman Admin > AI
# Processing tanpa restart (tersimpan di tabel AppSetting, sama seperti
# PIN_HASH hasil "Lupa PIN").
#
# AI_MODE = "local" | "cloud" | "hybrid" (default: local)
# AI_MODE="local"
#
# Provider lokal — Ollama (https://ollama.com), jalankan `ollama serve`.
# Nama model TIDAK di-hardcode di kode — isi model apa pun yang sudah
# di-`ollama pull`, mis. llava/qwen2.5vl/gemma3/mistral/phi4.
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llava"
#
# Provider cloud — Gemini API (https://aistudio.google.com/apikey). Bisa
# juga diisi lewat halaman Settings (disimpan terenkripsi di DB) daripada
# di sini — kalau keduanya ada, nilai dari halaman Settings yang menang.
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.5-flash"
