# Salin file ini menjadi .env dan isi nilainya. .env tidak di-commit ke git
# (lihat .gitignore) karena berisi rahasia (PIN, kredensial Google).

DATABASE_URL="file:./prisma/dev.db"

# --- FR-6B: PIN Gate (wajib diisi agar aplikasi bisa diakses) ---------
# PIN_HASH = SHA-256 hex dari PIN akses kantor (4-6 digit), BUKAN plaintext.
# Hasilkan dengan: npx tsx scripts/hash-pin.ts <PIN-PILIHAN-ANDA>
# Lihat SETUP.md untuk cara reset PIN kalau lupa.
PIN_HASH=""

# SESSION_SECRET = string acak panjang untuk menandatangani cookie sesi.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mengubah nilai ini akan membuat semua sesi yang sedang aktif logout.
SESSION_SECRET=""

# --- FR-1.2: Sinkronisasi HDD Eksternal (opsional) --------------------
# BACKUP_HDD_PATH = folder tujuan di HDD eksternal (mis. drive letter di
# Windows). Dicek tiap kali aplikasi start (bukan terjadwal presisi) — kalau
# drive tidak terpasang saat itu, dilewati diam-diam dan dicoba lagi di
# start berikutnya. Kosongkan untuk menonaktifkan.
# BACKUP_HDD_PATH="E:\notaris-backup"

# --- Integrasi Google Sheets (opsional, FR-1.3) — kosongkan untuk
# menonaktifkan fitur "Export ke Google Sheet" / sinkron otomatis saat CDD
# jadi Lengkap. Lihat panduan setup di percakapan/README.
# GOOGLE_SHEETS_SPREADSHEET_ID="..."
# GOOGLE_SERVICE_ACCOUNT_EMAIL="...@....iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SHEET_NAME="Sheet1"

# --- FR-1.4: Google Drive (opsional) — backup scan/foto ID. Pakai Service
# Account yang sama dengan Google Sheets di atas (GOOGLE_SERVICE_ACCOUNT_*),
# scope Drive-nya dibatasi ke file yang dibuat sendiri (drive.file). Buat
# folder khusus (bukan personal) di Drive akun tersebut, share ke email
# Service Account, salin ID foldernya dari URL Drive ke bawah ini.
# GOOGLE_DRIVE_FOLDER_ID="..."
